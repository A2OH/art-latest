+//       <- StorageKnotImpl.<clinit>   (com.bytedance.bdauditsdkbase.privacy.hook)
+// which is what aborts onCreate with "Attempt to get length of null array".
+// An empty array means "this API has nothing for you", which is what a stub should say; null means
+// "broken". Falls back to null if the type cannot be resolved, so this can only improve on the
+// previous behaviour.
+static inline bool WlSetEmptyArrayResult(Thread* self,
+                                         ArtMethod* referrer,
+                                         const DexFile* dex_file,
+                                         const dex::MethodId& method_id,
+                                         JValue* result)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  const dex::ProtoId& proto_id = dex_file->GetProtoId(method_id.proto_idx_);
+  ClassLinker* class_linker = Runtime::Current()->GetClassLinker();
+  ObjPtr<mirror::Class> ret_cls = class_linker->ResolveType(proto_id.return_type_idx_, referrer);
+  if (ret_cls == nullptr) {
+    self->ClearException();
+    return false;
+  }
+  if (!ret_cls->IsArrayClass()) {
+    return false;
+  }
+  gc::Heap* heap = Runtime::Current()->GetHeap();
+  ObjPtr<mirror::Array> empty = mirror::Array::Alloc(self,
+                                                     ret_cls,
+                                                     /*component_count=*/0,
+                                                     ret_cls->GetComponentSizeShift(),
+                                                     heap->GetCurrentAllocator());
+  if (empty == nullptr) {
+    self->ClearException();
+    return false;
+  }
+  result->SetL(empty);
+  return true;
+}
